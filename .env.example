# Use a long random value of at least 32 characters.
MADAGIN_AUTH_SECRET=

# Password-only owner access for the private workspace.
MADAGIN_INTERNAL_PASSWORD=

# Server-only Vercel Web Analytics API access.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_TEAM_SLUG=unigentamos

# Optional public hero film. Leave blank to use the intentional static field.
NEXT_PUBLIC_MADAGIN_HERO_VIDEO=

# Direct public inquiry destination: a mailto, calendar, or contact URL.
NEXT_PUBLIC_MADAGIN_CONTACT_HREF=

# Private Vercel Blob token for projects and blog publishing.
BLOB_READ_WRITE_TOKEN=

# Canonical public origin used by the sitemap.
NEXT_PUBLIC_SITE_URL=https://projectwebbing.vercel.app
